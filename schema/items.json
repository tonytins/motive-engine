{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motivesengine.dev/schemas/item.schema.json",
  "title": "Legacy Item",
  "description": "One item in the legacy single-item format, with raw motive values. Raw values are divided by 25 to give per-second rates. Content packs use schema/pack-items.json instead.",
  "type": "object",
  "$defs": {
    "modifier": {
      "type": "string",
      "enum": ["appliance", "bed", "shower", "toilet", "recreation", "sim", "ambient", "chair", "skill"]
    },
    "motiveValue": {
      "type": "object",
      "description": "One motive and its raw value, such as { \"hunger\": 50 }.",
      "propertyNames": { "enum": ["hunger", "energy", "hygiene", "bladder", "social", "fun"] },
      "additionalProperties": { "type": "number" },
      "minProperties": 1,
      "maxProperties": 1
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The item's display name."
    },
    "item": {
      "description": "One modifier, or a nonempty list of them.",
      "oneOf": [
        { "$ref": "#/$defs/modifier" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/modifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "motives": {
      "type": "array",
      "items": { "$ref": "#/$defs/motiveValue" },
      "description": "The motives this item fulfills while a Sim uses it."
    },
    "blocking": {
      "type": "boolean",
      "description": "Whether Sims can walk through the item. When absent, it blocks if any modifier except ambient or sim is present."
    }
  },
  "required": ["name", "item", "motives"],
  "additionalProperties": false,
  "examples": [
    { "name": "Fridge", "item": "appliance", "motives": [{ "hunger": 50 }] },
    { "name": "Television", "item": "recreation", "motives": [{ "fun": 25 }, { "social": 7.5 }] },
    { "name": "Stereo", "item": ["ambient", "recreation"], "motives": [{ "fun": 15 }], "blocking": false }
  ]
}
