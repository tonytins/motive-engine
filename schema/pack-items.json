{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motivesengine.dev/schemas/pack-items.schema.json",
  "title": "Content Pack Items",
  "description": "The optional items.json file of a content pack. IDs without a pack prefix are qualified with the pack's ID; a prefixed ID overrides another pack's definition and must be listed in the manifest's overrides. Motive values are per-second rates.",
  "type": "object",
  "$defs": {
    "motiveRates": {
      "type": "object",
      "propertyNames": { "enum": ["hunger", "energy", "hygiene", "bladder", "social", "fun"] },
      "additionalProperties": { "type": "number" }
    },
    "interaction": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "duration": { "type": "number", "exclusiveMinimum": 0, "description": "Active duration in simulated seconds." },
        "advertises": { "$ref": "#/$defs/motiveRates", "description": "Expected benefits used by free will." },
        "effects": { "$ref": "#/$defs/motiveRates", "description": "Applied effects. Ignored when a script is set." },
        "posture": { "enum": ["standing", "sitting"], "description": "Required actor posture." },
        "script": {
          "type": "string",
          "pattern": "^[^/\\\\]+$",
          "description": "A file in the pack's scripts folder, without the .rob extension. Compiled when the pack loads."
        }
      },
      "required": ["id", "name", "duration"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "modifiers": {
          "type": "array",
          "items": { "enum": ["appliance", "bed", "shower", "toilet", "recreation", "sim", "ambient", "chair", "skill"] },
          "uniqueItems": true
        },
        "blocking": { "type": "boolean", "description": "Overrides the modifiers' default blocking." },
        "capacity": { "type": "integer", "minimum": 1, "default": 1 },
        "signals": { "$ref": "#/$defs/motiveRates", "description": "Passive signals, used by ambient buffs." },
        "interactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/interaction" }
        }
      },
      "required": ["id", "name", "modifiers"],
      "additionalProperties": false
    }
  },
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "required": ["items"],
  "additionalProperties": false,
  "examples": [
    {
      "items": [
        {
          "id": "base:fridge",
          "name": "Deluxe Fridge",
          "modifiers": ["appliance"],
          "interactions": [
            {
              "id": "eat",
              "name": "Have a Snack",
              "duration": 20,
              "advertises": { "hunger": 2 },
              "effects": { "hunger": 2 }
            },
            {
              "id": "feast",
              "name": "Have a Feast",
              "duration": 60,
              "advertises": { "hunger": 3, "fun": 0.5 },
              "script": "feast"
            }
          ]
        },
        {
          "id": "radio",
          "name": "Kitchen Radio",
          "modifiers": ["ambient", "recreation"],
          "signals": { "fun": 0.25 }
        }
      ]
    }
  ]
}
